{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan barcode produk dengan kamera.",
        "NSPhotoLibraryUsageDescription": "Pilih foto produk untuk katalog.",
        "NSBluetoothAlwaysUsageDescription": "Hubungkan printer kasir dan dapur."
      },
      "bundleIdentifier": "com.emergent.kasirandroidpro.ijd6qs"
    },
    "android": {
      "permissions": ["CAMERA", "BLUETOOTH_SCAN", "BLUETOOTH_CONNECT"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.kasirandroidpro.ijd6qs"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-camera",
      "expo-image-picker",
      "expo-document-picker",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}